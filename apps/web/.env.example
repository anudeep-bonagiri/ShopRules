# NVIDIA Nemotron 3 on Nebius Token Factory (required for live checks)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Override model ids if the catalog changes
# NEMOTRON_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEMOTRON_SUPER=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Token Factory Sandboxes (Rule Forge runs the agent-written checks here). Project ID from Token Factory, Project settings.
NEBIUS_PROJECT_ID=
# NEBIUS_SANDBOX_IMAGE=tag:python:3.12-slim

# Tavily (optional: without a key, Search and Extract run in Tavily's free keyless mode)
TAVILY_API_KEY=

# Storage: Vercel Blob read-write token (vercel blob create-store, then vercel env pull)
# Storage: Postgres (preferred) or Vercel Blob. Apply apps/web/supabase/store.sql to the database first.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Protects the scheduled watch run (/api/cron/check). Any long random string.
CRON_SECRET=

# Optional Telegram delivery: create a bot with @BotFather, then set your chat id in Settings
TELEGRAM_BOT_TOKEN=

# Public URL of this deployment, used in Telegram links
APP_BASE_URL=http://localhost:3000
