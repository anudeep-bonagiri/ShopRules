// Live Tavily verification run: Map or Crawl plus Extract on N state revenue
// sites for nexus thresholds, and Extract on hts.usitc.gov for the demo
// products' headings. Writes docs/TAVILY-RUN.md. Costs Tavily credits; needs
// TAVILY_API_KEY for Map and Crawl (Extract falls back to keyless).
//
//   set -a && . ./apps/web/.env.local && set +a && npx -y tsx@4.19.4 scripts/tavily-verify.mts [--states 8] [--only TX,CA,NY] [--headings 9503,9405,6109]
import { writeFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import * as ncNs from "../apps/web/src/lib/nexus-crawl";
import * as hrNs from "../apps/web/src/lib/hts-rate";
import * as nxNs from "../apps/web/src/lib/nexus";
import * as scNs from "../apps/web/src/lib/schemas";
import type { NexusVerification } from "../apps/web/src/lib/nexus-crawl";
import type { HtsRateResult } from "../apps/web/src/lib/hts-rate";

// tsx compiles the web app's modules to CommonJS, so named exports arrive under `default`.
const unwrap = <T,>(m: T): T => ((m as { default?: T }).default ?? m) as T;
const { verifyStateThreshold } = unwrap(ncNs);
const { fetchHtsRate, htsRateLine } = unwrap(hrNs);
const { NEXUS_SEEDS } = unwrap(nxNs);
const { newMeter } = unwrap(scNs);

const here = dirname(fileURLToPath(import.meta.url));
const root = resolve(here, "..");
const args = process.argv.slice(2);
const arg = (name: string) => (args.includes(name) ? args[args.indexOf(name) + 1] : null);
const only = arg("--only")?.split(",").map((s) => s.trim().toUpperCase()) ?? null;
const count = Number(arg("--states") ?? 8);
// Demo products: toy (9503), lamp (9405), tee (6109).
const headings = (arg("--headings") ?? "9503,9405,6109").split(",").map((s) => s.trim());

async function main(): Promise<void> {
  const meter = newMeter();
  const seeds = (only ? NEXUS_SEEDS.filter((s) => only.includes(s.state)) : NEXUS_SEEDS).slice(0, only ? undefined : count);
  const states: NexusVerification[] = [];
  for (const seed of seeds) {
    const v = await verifyStateThreshold(seed, meter);
    states.push(v);
    console.log(`${v.verified ? "OK  " : "MISS"} ${v.line}  [${v.method}, mapped ${v.crawled}, read ${v.extracted}]`);
  }
  const rates: HtsRateResult[] = [];
  for (const h of headings) {
    const r = await fetchHtsRate(h, meter);
    rates.push(r);
    console.log(`${r.verified ? "OK  " : "MISS"} ${htsRateLine(r)}`);
  }
  const verified = states.filter((s) => s.verified);
  const matching = verified.filter((s) => s.matches_seed);
  const md = [
    "# Tavily verification run",
    "",
    `Generated by \`scripts/tavily-verify.mts\` at ${new Date().toISOString()}. Tavily calls: ${meter.tavily_calls}, credits: ${meter.tavily_credits}. No model calls.`,
    "",
    `## Nexus thresholds: ${verified.length} of ${states.length} states verified, ${matching.length} match the seed, ${verified.length - matching.length} differ`,
    "",
    "| State | Result | Method | Mapped | Read | Parsed | Seed match | Quote |",
    "| --- | --- | --- | --- | --- | --- | --- | --- |",
    ...states.map((s) => {
      const p = s.parsed;
      const parsed = p ? `${p.dollars != null ? `$${p.dollars.toLocaleString("en-US")}` : ""}${p.transactions != null ? ` ${p.operator ?? ""} ${p.transactions} tx` : ""}${p.period ? `, ${p.period.replace(/_/g, " ")}` : ""}`.trim() : "";
      return `| ${s.state} | ${s.verified ? "verified" : "not verified"} | ${s.method} | ${s.crawled} | ${s.extracted} | ${parsed} | ${s.verified ? (s.matches_seed ? "yes" : `no: ${s.differences.join("; ")}`) : s.reason ?? ""} | ${p ? p.quote.replace(/\|/g, "/").slice(0, 160) : ""} |`;
    }),
    "",
    "Lines as the seller sees them:",
    "",
    ...states.map((s) => `- ${s.line}`),
    "",
    `## Duty rates from hts.usitc.gov: ${rates.filter((r) => r.verified).length} of ${rates.length} headings read`,
    "",
    "| Heading | Result | Description | General | Column 2 | Line | Source |",
    "| --- | --- | --- | --- | --- | --- | --- |",
    ...rates.map((r) => `| ${r.heading} | ${r.verified ? "read" : `not read: ${r.reason ?? ""}`} | ${(r.description ?? "").slice(0, 80)} | ${r.general ?? ""} | ${r.column2 ?? ""} | ${r.rows[0]?.htsno ?? ""} | ${r.url ?? ""} |`),
    "",
    ...rates.map((r) => `- ${htsRateLine(r)}`),
    "",
  ].join("\n");
  writeFileSync(join(root, "docs", "TAVILY-RUN.md"), md);
  console.log(`\nWrote docs/TAVILY-RUN.md (${meter.tavily_calls} Tavily calls, ${meter.tavily_credits} credits).`);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
