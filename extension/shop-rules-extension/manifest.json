{
  "manifest_version": 3,
  "name": "Shop Rules",
  "version": "0.1.0",
  "description": "Shows the tariff, product safety, and sales-tax rules that touch a product listing, with open alerts, price history, and competitor prices.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.etsy.com/*",
    "https://*.myshopify.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shop Rules",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the Shop Rules panel for the hovered or current product"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.etsy.com/*",
        "https://*.myshopify.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
