{
  "name": "shop-rules",
  "repository": {
    "type": "git",
    "url": "https://github.com/anudeep-bonagiri/ShopRules.git"
  },
  "homepage": "https://shop-rules.vercel.app",
  "private": true,
  "workspaces": [
    "apps/web",
    "extension"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w extension",
    "build:web": "npm run build -w apps/web",
    "build:ext": "npm run build -w extension",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w extension",
    "test": "node --test apps/web/src/lib/*.test.ts extension/test/*.test.ts",
    "smoke": "node scripts/smoke.mts",
    "eval": "npx -y tsx@4.19.4 scripts/eval.mts",
    "eval:offline": "npx -y tsx@4.19.4 scripts/eval.mts --offline",
    "test:ext": "node --test extension/test/extract.test.mts",
    "shots:ext": "node extension/test/shots.mts",
    "seed": "npx -y tsx@4.19.4 seed/generate.mts",
    "facts": "scripts/full_run.sh",
    "demo:up": "scripts/demo_up.sh",
    "rehearse": "scripts/rehearse.sh"
  }
}
